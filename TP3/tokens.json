[
    {
        "id": "COMMENT",
        "regex": "#.*"
    },
    {
        "id": "VAR",
        "regex": "\\?\\w+"
    },
    {
        "id": "LANGUAGE",
        "regex": "@\\w{2}"
    },
    {
        "id": "STR",
        "regex": "\"[^\"]*\""
    },
    {
        "id": "DELIMITER",
        "regex": "[{}.]"
    },
    {
        "id": "LIMIT",
        "regex": "(?i:LIMIT)\\b"
    },
    {
        "id": "SELECT",
        "regex": "(?i:SELECT)\\b"
    },
    {
        "id": "WHERE",
        "regex": "(?i:WHERE)\\b"
    },
    {
        "id": "INT",
        "regex": "\\d+"
    },
    {
        "id": "CONCEPT",
        "regex": "\\w+(?::\\w+)*"
    },
    {
        "id": "SKIP",
        "regex": "[ \\t]"
    }
]